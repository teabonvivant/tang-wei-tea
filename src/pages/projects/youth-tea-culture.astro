---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Conversation from '../../components/Conversation.astro';
import Arrow from '../../components/Arrow.astro';
import { getEntry } from 'astro:content';
import { u, imgInfo, fmtDate, categoryName } from '../../lib/site';
const notes = await Promise.all(['first-lesson-questions', 'practice-with-water', 'children-observe-tea'].map(async (id) => (await getEntry('articles', id))!));
const img = (s: string) => imgInfo(s);
const records = [
  ['2024 至 2025 年度回顧', '初識茶、培訓、交流，都在這一年裏', '嶺南大學在 2026 年 1 月公布年度成果：計劃培訓 15 位大學生為準茶藝師，並舉辦逾 35 場茶藝工作坊及 5 場大型講座，中國茶也因此接觸到更多青年。', '嶺南大學 2026 年活動紀錄'],
  ['2025 年 3 月', '中國茶藝先修班', '兩場合共五小時的先修班有 60 位大學生參加，內容包括茶文化與產業介紹，並安排沖泡體驗。', '嶺南大學 2025 年活動紀錄'],
  ['2025 年 6 至 9 月', '茶藝師職業培訓與考試', '計劃安排 16 位學員修讀 20 小時專業課程，並前往廣州研習及參加職業考試，從課堂走進更深入的專業訓練。', '嶺南大學年度紀錄'],
  ['2025 年 11 月 25 日', '認識中國茶具與收藏心得', '唐娓以香港古樹茶文化學會會長身分主講，從茶具材質、使用、修復與收藏談起，也分享選擇器物時先看實用的想法。', '嶺南大學活動紀錄'],
  ['2026 年 1 月', '中國經典茶款講座', '在計劃年度成果分享會上，唐娓女士介紹紅茶、香片、鐵觀音與普洱的產地和工藝；受訓學員即場示範沖泡，向超過 150 位參加者提供四款中國茶。', '嶺南大學 2026 年活動紀錄'],
  ['2026 年 4 至 10 月', '中學茶文化工作坊', '工作坊於 2026 年 4 至 10 月在屯門、元朗、沙田、北區、葵青及九龍城的中學舉行，讓學生在校園接觸茶藝與文化。', '嶺南大學 2026 年活動紀錄'],
];
---
<Base title="一杯茶，也走進年輕人的日常｜唐娓老師" description="青年茶文化推廣計劃的公開紀錄：課堂、調查、年度成果與唐娓老師的講座。" path="/projects/youth-tea-culture/">
  <article>
    <header class="wrap page-intro">
      <div>
        <nav class="crumbs" aria-label="麵包屑" style="padding:0 0 16px"><a href={u('/events/')}>教學紀錄</a><span aria-hidden="true">/</span><span>青年與茶</span></nav>
        <h1>一杯茶，也走進<br />年輕人的日常。</h1>
      </div>
      <div style="display:grid;gap:16px;align-content:end">
        <p class="label">青年茶文化推廣計劃</p>
        <p class="intro-copy">一片茶的來處，也可以攤在年輕人眼前。從好奇開始，慢慢學會觀察與分享。</p>
        <a class="text-link" href="#classroom"><span>走進課堂</span></a>
      </div>
    </header>
    <div class="wrap" style="margin-bottom:96px">
      <figure style="margin:0"><img class="ph" style="width:100%;height:auto" src={img('/images/youth-lecture.jpg').src} width={img('/images/youth-lecture.jpg').width} height={img('/images/youth-lecture.jpg').height} alt="參與者在課堂上圍桌觀察茶樣" decoding="async" fetchpriority="high" /><figcaption class="t-small muted" style="margin-top:8px">從眼前的茶樣開始。照片取自學會青年茶文化活動相簿。</figcaption></figure>
    </div>
    <section class="wrap section split" style="padding-top:0">
      <h2>文化要傳下去，<br />先要有人親身接觸過。</h2>
      <div class="copy">
        <p>嶺南大學亞太老年學研究中心推動青年茶文化教育，在田家炳基金會支持下，透過講座與茶藝工作坊，讓青年及公眾認識中國茶文化。</p>
        <p>唐娓老師為青年茶文化計劃講師，自 2024 年起獲邀教授青年茶藝師課程。香港古樹茶文化學會的活動相簿，留下了唐娓與張家詠兩位老師參與教學的紀錄。</p>
      </div>
    </section>
    <section class="band-deep section">
      <div class="wrap split">
        <div class="copy">
          <p class="label">從調查看青年與茶</p>
          <h2>喝過一杯茶，也想多認識一點。</h2>
          <p>嶺南大學亞太老年學研究中心在 2025 年訪問 488 位 12 至 39 歲的香港居民，了解他們對中國茶的認識與飲用習慣。結果顯示一個有趣的落差：不少人常喝茶，對沖泡方法卻未必熟悉。</p>
          <p class="t-small">調查於 2025 年 3 至 7 月進行，共訪問 488 位 12 至 39 歲香港居民。</p>
        </div>
        <dl class="stat-grid" style="grid-template-columns:1fr">
          <div><dt>76.2%</dt><dd>受訪者表示有定期飲用中國茶的習慣</dd></div>
          <div><dt>44.2%</dt><dd>對中國茶沖泡技巧尚未認識，或只曾聽聞</dd></div>
          <div><dt>68.1%</dt><dd>對學習茶藝表示有一般、頗有或很大興趣</dd></div>
        </dl>
      </div>
    </section>
    <section class="wrap section">
      <p class="label">公開計劃紀錄</p>
      <h2 class="h2" style="margin:8px 0 16px">一堂課，接着一段更長的路。</h2>
      <p class="muted" style="max-width:var(--measure);margin-bottom:32px">先修課、職業培訓、校園工作坊、專題分享，茶文化在一個又一個場景裏延續。嶺南大學的活動紀錄亦收錄了唐娓老師的講座。</p>
      <ol class="timeline">
        {records.map(([when, title, body, src]) => (
          <li><span class="when">{when}</span><div><h3>{title}</h3><p>{body}</p><p class="t-small" style="margin-top:8px">{src}</p></div></li>
        ))}
      </ol>
    </section>
    <section class="wrap section" id="classroom" style="padding-top:0">
      <div class="section-heading"><div><h2 class="h2">在課堂，與茶相遇</h2><p>觀看、嘗試、交流，公開相簿裏留下了學習的不同片段。</p></div></div>
      <div style="display:grid;gap:64px">
        <div class="split">
          <figure style="margin:0"><img class="ph" style="width:100%;height:auto" src={img('/images/youth-class.jpg').src} width={img('/images/youth-class.jpg').width} height={img('/images/youth-class.jpg').height} alt="講者在投影幕前向現場參與者介紹茶文化" loading="lazy" decoding="async" /><figcaption class="t-small muted" style="margin-top:8px">講座現場：一個共同的話題，就是認識茶的開端。</figcaption></figure>
          <div class="copy"><p class="label">從認識開始</p><h3 class="h3">先留一點空間，給好奇。</h3><p>不同經驗的人，都有機會在這裏一起接觸茶。看見器物、聽一段講解，再帶着自己的問題坐到茶桌旁，知識便與日常連起來了。</p></div>
        </div>
        <div class="split reverse">
          <figure style="margin:0"><img class="ph" style="width:100%;height:auto" src={img('/images/youth-practice.jpg').src} width={img('/images/youth-practice.jpg').width} height={img('/images/youth-practice.jpg').height} alt="參與者坐在茶席前，手持小杯細看" loading="lazy" decoding="async" /><figcaption class="t-small muted" style="margin-top:8px">茶席實作片段：把注意力放回眼前的器物與茶湯。</figcaption></figure>
          <div class="copy"><p class="label">在手上練習</p><h3 class="h3">親手做一次，問題就具體了。</h3><p>杯子拿起來的感覺，器具放置的距離，都可以親自察覺。學茶的樂趣，就是把抽象的講解慢慢變成自己的理解。</p><a class="text-link" href={u('/topics/learning/')}><span>閱讀教學筆記</span><Arrow /></a></div>
        </div>
      </div>
    </section>
    <section class="wrap section" style="padding-top:0">
      <h2 class="h2" style="margin-bottom:16px">一席之間，可以遇見很多種人。</h2>
      <p class="muted" style="margin-bottom:32px">一起聽、一起做，也一起留下紀錄。課堂中的人，是茶文化最實在的部分。</p>
      <div class="gallery">
        <figure><img class="ph" style="width:100%;height:auto" src={img('/images/youth-tea.jpg').src} width={img('/images/youth-tea.jpg').width} height={img('/images/youth-tea.jpg').height} alt="參與者在茶桌旁合照" loading="lazy" decoding="async" /><figcaption>課堂合照。照片：香港古樹茶文化學會。</figcaption></figure>
        <figure><img class="ph" style="width:100%;height:auto" src={img('/images/youth-group.jpg').src} width={img('/images/youth-group.jpg').width} height={img('/images/youth-group.jpg').height} alt="參與者坐在擺有茶具的桌旁聆聽現場講解" loading="lazy" decoding="async" /><figcaption>圍桌聆聽講解，認識茶與器物。</figcaption></figure>
      </div>
    </section>
    <section class="wrap section" style="padding-top:0">
      <div class="section-heading"><div><h2 class="h2">課堂以外，繼續想茶</h2><p>由觀察與練習開始，學習才走進日常。</p></div><a class="text-link" href={u('/topics/learning/')}><span>閱讀這個系列</span><Arrow /></a></div>
      <div class="article-grid">
        {notes.map((a) => (
          <article class="card"><a class="cover-link" href={u(`/journal/${a.id}/`)} tabindex="-1" aria-hidden="true"><Cover src={a.data.cover} alt="" /></a><div style="display:grid;gap:8px"><div class="meta"><span>{categoryName(a)}</span><span>{fmtDate(a.data.date)}</span></div><h3><a href={u(`/journal/${a.id}/`)}>{a.data.title}</a></h3><p>{a.data.excerpt}</p></div></article>
        ))}
      </div>
    </section>
    <section class="wrap section" style="padding-top:0">
      <div class="plain-block"><h2 class="h2">校園以外，繼續認識唐老師</h2><p>唐娓老師的教學亦包括職業茶藝師課程、普洱講座及中小學茶文化活動。個人介紹頁已整理學歷、專業背景與歷年教學紀錄。</p><a class="text-link" href={u('/about/')}><span>閱讀完整導師介紹</span><Arrow /></a></div>
    </section>
    <section class="band-deep section">
      <div class="wrap split">
        <div class="copy"><p class="label">學校與文化合作</p><h2>茶文化，就在下一次相遇裏延續。</h2><p>想為學生安排一場茶文化活動？歡迎帶着年齡、主題與想法，坐下來談。</p></div>
        <div><a class="button on-deep" href={u('/contact/?topic=youth')}>交流學校及青年活動構思</a></div>
      </div>
    </section>
    <section class="wrap section">
      <h2 class="h3" style="margin-bottom:16px">資料與影像出處</h2>
      <p class="muted" style="max-width:var(--measure)">本頁資料取自嶺南大學青年茶文化推廣計劃的公開頁面（含 2025、2026 年度活動紀錄及青年飲茶習慣調查摘要），以及香港古樹茶文化學會的導師介紹與活動相簿；活動照片由香港古樹茶文化學會提供。</p>
    </section>
  </article>
</Base>
