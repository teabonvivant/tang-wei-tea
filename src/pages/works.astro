---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Cover from '../components/Cover.astro';
import Arrow from '../components/Arrow.astro';
import GoldDivider from '../components/GoldDivider.astro';
import { allRepair, allTerms, topicArticles, u, fmtDate, imgInfo } from '../lib/site';
const rep = await allRepair();
const latest = rep.slice(0, 3);
const vessels = await topicArticles('vessels');
const hosting = await topicArticles('hosting');
const terms = await allTerms();
const sample = ['金繕', '開片', '生漆'].map((n) => terms.find((t) => t.data.term === n)!).filter(Boolean);
const hero = rep.find((r) => r.id === 'what-is-kintsugi')!;
const gates = [
  { href: '/topics/vessels/', title: '選器・用器', body: '蓋碗、公道杯、茶巾、一把壺。由合手、好用與清潔着眼，慢慢挑出自己的茶具。', n: `${vessels.length} 篇筆記`, img: vessels[0].data.cover, alt: '' },
  { href: '/repair/', title: '修器', body: '杯碗碎了、裂了、崩了怎麼辦？金繕與鋦瓷是甚麼？修過的器物能不能盛茶、上茶席？', n: `${rep.length} 篇文章與小詞典`, img: hero.data.cover, alt: '' },
  { href: '/topics/hosting/', title: '茶席', body: '安排器物，也照顧席間每一個人的需要。', n: `${hosting.length} 篇筆記`, img: hosting[0].data.cover, alt: '' },
];
---
<Base title="器物：選器、修器與茶席｜唐娓老師" description="由好用的器物到照顧人的心意：選器與用器、器物破損後的修補知識，以及茶席與待客。" path="/works/" ogImage="/images/repair/what-is-kintsugi.jpg">
  <section class="band-deep" style="padding-top:72px">
    <div class="wrap split" style="padding-block:64px 96px">
      <div class="copy">
        <p class="label">器物</p>
        <h1 style="font-size:clamp(36px,6vw,56px)">器物之間</h1>
        <p class="t-lead" style="color:var(--green-mist)">茶桌上的器物，每一件都是用來陪人喝茶的。好用、合手、洗得乾淨，是我挑器物時最先想到的事；用久了難免磕碰，修不修、怎樣修，也值得先想一想。</p>
      </div>
      <div class="gate-hero gold-frame">
        <Cover src={hero.data.cover} alt={hero.data.coverAlt} priority sizes="(min-width: 900px) 560px, 100vw" />
      </div>
    </div>
  </section>
  <section class="wrap section">
    <h2 class="h2" style="margin-bottom:40px">三道門</h2>
    <div class="gate-grid" data-stagger>
      {gates.map((g) => (
        <a class="gate" href={u(g.href)}>
          <Cover src={g.img} alt={g.alt} />
          <span class="label">{g.n}</span>
          <h3>{g.title}</h3>
          <p>{g.body}</p>
          <span class="more">進去看看</span>
        </a>
      ))}
    </div>
  </section>
  <section class="wrap" style="padding-bottom:96px">
    <GoldDivider class="paper-gold" />
    <div class="section-heading" style="margin-top:64px"><div><h2 class="h2">最新修器</h2></div><a class="text-link" href={u('/repair/')}><span>全部修器文章</span><Arrow /></a></div>
    <div class="article-grid">
      {latest.map((r) => <ArticleCard href={`/repair/${r.id}/`} title={r.data.title} excerpt={r.data.excerpt} cover={r.data.cover} alt="" category="修器" date={fmtDate(r.data.date)} />)}
    </div>
  </section>
  <section class="band-deep section">
    <div class="wrap" style="display:grid;gap:40px">
      <div class="section-heading" style="margin-bottom:0"><div><h2 class="h2">修補小詞典</h2><p style="color:var(--green-mist)">三個常見的詞。</p></div><a class="text-link" href={u('/repair/glossary/')}><span>翻開小詞典</span><Arrow /></a></div>
      <div class="cards-2" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">
        {sample.map((t) => <a href={u(`/repair/glossary/#${t.id}`)} style="text-decoration:none;display:grid;gap:8px;padding:24px 0;border-top:1px solid rgba(246,246,243,.2)"><strong class="serif" style="font-size:22px;font-weight:500">{t.data.term}</strong><span style="color:var(--green-mist);font-size:16px;line-height:1.8">{t.data.short}</span></a>)}
      </div>
    </div>
  </section>
</Base>
