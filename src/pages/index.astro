---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Cover from '../components/Cover.astro';
import Arrow from '../components/Arrow.astro';
import Conversation from '../components/Conversation.astro';
import GoldDivider from '../components/GoldDivider.astro';
import { u, imgInfo, topicBySlug, fmtDate, categoryName, shownDate } from '../lib/site';

const get = async (id: string) => (await getEntry('articles', id))!;
const feature = await get('first-gaiwan');
const list = await Promise.all(['smelling-dry-leaves', 'raw-ripe-first-lesson', 'room-at-the-table'].map(get));
const column = await get('tea-path-awakening-the-senses');
const kintsugi = await getEntry('repair', 'what-is-kintsugi');
const hero = imgInfo('/images/tea.webp');
const person = imgInfo('/images/teaching-1.jpg');
const youth = imgInfo('/images/youth-lecture.jpg');
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: '唐娓老師', url: u('/'), inLanguage: 'zh-Hant-HK' },
  { '@context': 'https://schema.org', '@type': 'Person', name: '唐娓', jobTitle: '茶藝導師', description: '香港古樹茶文化學會會長，中國茶藝教學與普洱研習。', url: u('/about/') },
];
---
<Base title="唐娓老師｜茶、器物與日常" description="唐老師的茶、器物與日常。中國茶藝教學、普洱茶評審與製作，以一席茶，認識生活中的文化與美。" path="/" overHero jsonld={jsonld}>
  <section class="hero">
    <div class="hero-stage" aria-hidden="false">
      <div class="hero-art">
        <img class="hero-image" src={hero.src} width={hero.width} height={hero.height} alt="紫砂壺、白瓷杯與琥珀色的茶湯" fetchpriority="high" decoding="async" />
        <svg class="hero-lines" viewBox="0 0 1400 933" aria-hidden="true">
          <path class="gold-line" pathLength="1" d="M1010 667 C 1003 680, 1023 691, 1012 707 C 1004 719, 1007 730, 992 746" />
        </svg>
      </div>
    </div>
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <p class="hero-identity">唐娓老師·中國茶藝教學·普洱研習</p>
      <h1>一席茶裏，<br />有一段從容的時光。</h1>
      <p class="hero-description"><span class="nb">一片葉的來處，</span><span class="nb">連着器物、風土，</span><span class="nb">與人的日常。</span></p>
      <div class="hero-actions">
        <a class="button on-deep" href={u('/about/')}>走近唐老師</a>
        <a class="text-link" style="color:var(--on-deep)" href={u('/journal/')}><span>讀文章</span><Arrow /></a>
        <a class="text-link" style="color:var(--on-deep)" href={u('/works/')}><span>看器物與修補</span><Arrow /></a>
        <a class="text-link" style="color:var(--on-deep)" href={u('/contact/')}><span>聯絡唐老師</span><Arrow /></a>
      </div>
    </div>
  </section>

  <section class="wrap section opening" data-stagger>
    <div>
      <p class="vertical">在生活裏，慢慢學茶</p>
      <h2>茶喝得明白，<br />日子自然過得仔細。</h2>
    </div>
    <div class="opening-copy">
      <p>一點水溫的改變，一隻拿得穩的杯，還有坐在茶桌旁，願意互相聆聽的人。</p>
      <p>由唐娓老師的教學與專欄，認識中國茶藝與普洱；茶間筆記裏，也有適合自己的沖泡、器物與日常。</p>
      <a class="text-link" href={u('/tea/')}><span>從這裏開始學茶</span><Arrow /></a>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:96px">
    <div class="section-heading">
      <div><h2 class="h2">今天，從一個問題開始</h2><p>入門沖泡、感官品飲、器物與生活。</p></div>
      <a class="text-link" href={u('/journal/')}><span>閱讀茶間筆記</span><Arrow /></a>
    </div>
    <div class="feature-layout" data-stagger>
      <ArticleCard variant="feature" href={`/journal/${feature.id}/`} title={feature.data.title} excerpt={feature.data.excerpt} cover={feature.data.cover} alt={feature.data.coverAlt} category={categoryName(feature)} date={shownDate(feature)} vt={`c-${feature.id}`} sizes="(min-width: 900px) 700px, 100vw" />
      <div class="plain-list" style="display:grid;align-content:start">
        <ul>
          {list.map((a) => (
            <li>
              <a class="row-link" style="grid-template-columns:1fr" href={u(`/journal/${a.id}/`)}>
                <span class="label">{categoryName(a)}</span>
                <h3>{a.data.title}</h3>
                <p>{a.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band-deep section">
    <div class="wrap">
      <GoldDivider />
      <div class="split" style="margin-top:64px">
        <div class="copy" data-stagger>
          <p class="label">器物之間，還有修補</p>
          <h2>杯子破了，<br />不一定要丟。</h2>
          <p>茶桌上的器物難免磕碰。先分清是開片還是裂縫，再想想要不要修、用甚麼方法修、修好後怎樣用。這一欄把修補的知識，放回茶桌的日常。</p>
          <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
            <a class="button on-deep" href={u('/repair/')}>走進修器</a>
            <a class="text-link" href={u('/works/')}><span>器物總覽</span><Arrow /></a>
          </div>
        </div>
        <a href={u('/repair/what-is-kintsugi/')} aria-label="閱讀：金繕是甚麼？" style="display:block"><Cover src={kintsugi!.data.cover} alt="" sizes="(min-width: 900px) 560px, 100vw" /></a>
      </div>
    </div>
  </section>

  <section class="wrap section split reverse">
    <div class="copy" data-stagger>
      <p class="label">唐娓 · 香港經濟日報</p>
      <h2>茶逢知己</h2>
      <p>茶葉、器物、教學與相處，都是唐老師寫下的日常。</p>
      <a class="text-link" href={u('/columns/')}><span>閱讀專欄選編</span><Arrow /></a>
    </div>
    <ArticleCard href={`/journal/${column.id}/`} title={column.data.title} excerpt={column.data.excerpt} cover={column.data.cover} alt={column.data.coverAlt} category="茶逢知己" date={shownDate(column)} vt={`c-${column.id}`} sizes="(min-width: 900px) 560px, 100vw" />
  </section>

  <section class="wrap section split reverse" style="padding-top:0">
    <figure>
      <img class="ph" style="width:100%;height:auto" src={person.src} width={person.width} height={person.height} alt="茶藝課堂上，學員圍桌觀察茶樣" loading="lazy" decoding="async" />
      <figcaption>課堂照片：香港古樹茶文化學會</figcaption>
    </figure>
    <div class="copy" data-stagger>
      <p class="label">在課堂，親手認識一杯茶</p>
      <h2>先看見，再親手做一次。</h2>
      <p>唐娓老師為香港古樹茶文化學會會長、茶藝導師，也是「茶逢知己」專欄作者。她教的範圍，由職業茶藝培訓、普洱研習到社區與校園工作坊，最後都回到那張可以觀察、練習與交流的茶桌。</p>
      <a class="text-link" href={u('/courses/')}><span>認識課程與合作</span><Arrow /></a>
    </div>
  </section>

  <section class="wrap section split reverse" style="padding-top:0">
    <div class="copy" data-stagger>
      <p class="label">文化教育專題 · 青年與茶</p>
      <h2>一杯茶，也走進<br />年輕人的日常。</h2>
      <p>由觀察茶樣，到坐下來親手泡茶。青年茶文化計劃留下的公開紀錄裏，可以看到茶怎樣走進校園，文化又怎樣在日常裏延續。</p>
      <a class="text-link" href={u('/projects/youth-tea-culture/')}><span>走進青年與茶</span><Arrow /></a>
      <p class="t-small muted">活動照片：香港古樹茶文化學會</p>
    </div>
    <a href={u('/projects/youth-tea-culture/')} aria-label="青年與茶專題"><img class="ph" style="width:100%;height:auto" src={youth.src} width={youth.width} height={youth.height} alt="課堂上圍桌觀察不同茶樣" loading="lazy" decoding="async" /></a>
  </section>

  <div class="band-deep"><Conversation deep /></div>
</Base>
