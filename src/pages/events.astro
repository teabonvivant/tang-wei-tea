---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Conversation from '../components/Conversation.astro';
import Arrow from '../components/Arrow.astro';
import { u, imgInfo } from '../lib/site';
const youth = imgInfo('/images/youth-lecture.jpg');
// 四類課堂紀錄：內容取自本站課程頁、關於頁與青年與茶專題已有的資料，不另寫活動。
const albums = [
  { t: '茶藝師職業課程', d: '初級至中級茶藝課堂，由唐娓老師任教。課堂由六大茶類、茶具與用水講起，練習沖泡控制與感官品鑑，最後到茶席設計與待客禮儀。', more: ['/courses/', '看課程與班期'] },
  { t: '中國茶文化與普洱講座', d: '普洱古樹茶研習及茶文化講座，原相簿標示由唐娓老師任教。從代表茶區認識山頭特色，練習品鑑與沖泡，交流茶葉辨識及收藏觀察。', more: ['/tea/', '先讀普洱筆記'] },
  { t: '中小學與幼兒茶藝', d: '包括校園師生、教師及家長教師會活動，由唐娓、張家詠兩位老師任教。學校與機構可按參加者年齡、人數與時長，商議講座、觀察與實作的比例。', more: ['/contact/', '查詢學校活動'] },
  { t: '嶺南大學青年茶文化', d: '青年茶文化推廣計劃的課堂，由唐娓、張家詠兩位老師任教。唐娓老師自 2024 年起獲邀教授青年茶藝師課程，2026 年 1 月主講中國經典茶款。', more: ['/projects/youth-tea-culture/', '走進青年與茶'] },
];
const photos = [
  ['/images/teaching-1.jpg', '圍桌觀察茶樣，交流品飲與沖泡。'],
  ['/images/teaching-4.jpg', '茶藝課程活動合照。'],
  ['/images/teaching-5.jpg', '普洱研習講座與茶席交流。'],
  ['/images/teaching-6.jpg', '講座參加者觀察茶餅與原料。'],
];
---
<Base title="教學紀錄｜唐娓老師" description="唐娓老師的教學紀錄：茶藝師課堂、普洱研習講座、中小學與幼兒茶藝，以及嶺南大學青年茶文化計劃，附香港古樹茶文化學會提供的課堂照片。" path="/events/">
  <PageIntro title="教學紀錄" intro="茶藝課堂、普洱研習、社區與校園。親手試過、交流過，才算開始認識茶文化。" />
  <section class="wrap section split" style="padding-top:0">
    <a href={u('/projects/youth-tea-culture/')} aria-label="青年與茶專題"><img class="ph" style="width:100%;height:auto" src={youth.src} srcset={youth.srcset} sizes="(min-width: 900px) 560px, (min-width: 640px) 50vw, 100vw" width={youth.width} height={youth.height} alt="課堂上圍桌觀察不同茶樣" decoding="async" fetchpriority="high" /></a>
    <div class="copy">
      <h2>一杯茶，也走進年輕人的日常。</h2>
      <p>由觀察茶樣，到坐下來親手泡茶。青年茶文化計劃留下的公開紀錄裏，可以看到茶怎樣走進校園，文化又怎樣在日常裏延續。</p>
      <a class="text-link" href={u('/projects/youth-tea-culture/')}><span>走進青年與茶</span><Arrow /></a>
      <p class="t-small muted">活動照片：香港古樹茶文化學會</p>
    </div>
  </section>
  <section class="wrap section" style="padding-top:0">
    <p class="label">學會公開教學紀錄</p>
    <h2 class="h2" style="margin:8px 0 32px">課堂與講座</h2>
    <div class="cards-2 fact-cards" data-stagger="cards">
      {albums.map((x) => (
        <article class="box"><h3>{x.t}</h3><p>{x.d}</p><a class="text-link" href={u(x.more[0])}><span>{x.more[1]}</span><Arrow /></a></article>
      ))}
    </div>
  </section>
  <section class="wrap section" style="padding-top:0">
    <div class="section-heading"><div><h2 class="h2">課堂裏的片段</h2><p>照片來自香港古樹茶文化學會教學相簿。</p></div></div>
    <div class="gallery">
      {photos.map(([src, cap]) => { const i = imgInfo(src); return (
        <figure><img class="ph" src={i.src} srcset={i.srcset} sizes="(min-width: 900px) 560px, (min-width: 640px) 50vw, 100vw" width={i.width} height={i.height} alt={cap} loading="lazy" decoding="async" style="width:100%;height:auto" /><figcaption>{cap}</figcaption></figure>
      ); })}
    </div>
  </section>
  <Conversation />
</Base>
