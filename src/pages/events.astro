---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Conversation from '../components/Conversation.astro';
import Arrow from '../components/Arrow.astro';
import { u, imgInfo } from '../lib/site';
const youth = imgInfo('/images/youth-lecture.jpg');
const albums = [
  ['茶藝師職業課程', '初級至中級茶藝課堂，由唐娓老師任教。'],
  ['中國茶文化與普洱講座', '普洱古樹茶研習及茶文化講座，原相簿標示由唐娓老師任教。'],
  ['中小學與幼兒茶藝', '包括校園師生、教師及家長教師會活動；由唐娓、張家詠兩位老師任教。'],
  ['嶺南大學青年茶文化', '青年茶文化推廣計劃課堂，由唐娓、張家詠兩位老師任教。'],
];
const photos = [
  ['/images/teaching-1.jpg', '圍桌觀察茶樣，交流品飲與沖泡。'],
  ['/images/teaching-4.jpg', '茶藝課程活動合照。'],
  ['/images/teaching-5.jpg', '普洱研習講座與茶席交流。'],
  ['/images/teaching-6.jpg', '講座參加者觀察茶餅與原料。'],
];
---
<Base title="教學紀錄｜唐娓老師" description="唐娓老師的茶藝課堂、普洱研習、社區與校園活動照片及教學紀錄。" path="/events/">
  <PageIntro title="教學紀錄" english="Tea brings us together." intro="茶藝課堂、普洱研習、社區與校園。親手試過、交流過，才算開始認識茶文化。" />
  <section class="wrap section split" style="padding-top:0">
    <a href={u('/projects/youth-tea-culture/')} aria-label="青年與茶專題"><img class="ph" style="width:100%;height:auto" src={youth.src} width={youth.width} height={youth.height} alt="課堂上圍桌觀察不同茶樣" decoding="async" fetchpriority="high" /></a>
    <div class="copy">
      <p class="label">文化教育專題 · 青年與茶</p>
      <h2>一杯茶，也走進年輕人的日常。</h2>
      <p>由觀察茶樣，到坐下來親手泡茶。青年茶文化計劃留下的公開紀錄裏，可以看到茶怎樣走進校園，文化又怎樣在日常裏延續。</p>
      <a class="text-link" href={u('/projects/youth-tea-culture/')}><span>走進青年與茶</span><Arrow /></a>
      <p class="t-small muted">活動照片：香港古樹茶文化學會</p>
    </div>
  </section>
  <section class="wrap section" style="padding-top:0">
    <p class="label">學會公開教學紀錄</p>
    <h2 class="h2" style="margin:8px 0 32px">課堂與講座</h2>
    <div class="cards-2">{albums.map(([t, d]) => <div class="box"><h3>{t}</h3><p>{d}</p></div>)}</div>
  </section>
  <section class="wrap section" style="padding-top:0">
    <div class="section-heading"><div><h2 class="h2">課堂裏的片段</h2><p>照片來自香港古樹茶文化學會教學相簿。</p></div></div>
    <div class="gallery">
      {photos.map(([src, cap]) => { const i = imgInfo(src); return (
        <figure><img class="ph" src={i.src} width={i.width} height={i.height} alt={cap} loading="lazy" decoding="async" style="width:100%;height:auto" /><figcaption>{cap}</figcaption></figure>
      ); })}
    </div>
  </section>
  <Conversation />
</Base>
