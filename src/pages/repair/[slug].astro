---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Arrow from '../../components/Arrow.astro';
import { allRepair, allTerms, bodyTerms, clusters, categoryName, u, abs, fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await allRepair()).map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const d = r.data;
const { Content } = await render(r);
const rep = await allRepair();
const terms = await allTerms();
const used = bodyTerms(r.body ?? '', terms).map((id) => terms.find((t) => t.id === id)!);
for (const name of d.terms) if (!terms.some((t) => t.data.term === name || t.data.aka.includes(name))) throw new Error(`${r.id}: frontmatter terms 含未知詞條「${name}」`);
const cluster = clusters.find((c) => c.id === d.cluster)!;
const i = rep.findIndex((x) => x.id === r.id);
const prev = i > 0 ? rep[i - 1] : null;
const next = i < rep.length - 1 ? rep[i + 1] : null;
const relTea = await Promise.all(d.relatedTea.map(async (x) => (await getEntry(x))!));
const relRep = d.relatedRepair.map((x) => rep.find((y) => y.id === x.id)!).filter(Boolean);
// 文末延伸：1 篇修器 + 2 篇茶文章（不足時補足至 3 張）
const cards = [...relRep.slice(0, 1).map((x) => ({ kind: 'repair', x })), ...relTea.slice(0, 2).map((x) => ({ kind: 'tea', x }))];
for (const x of [...relRep.slice(1), ...relTea.slice(2)]) { if (cards.length >= 3) break; cards.push({ kind: relRep.includes(x as any) ? 'repair' : 'tea', x } as any); }
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: d.title,
  datePublished: d.date.toISOString().slice(0, 10), author: { '@type': 'Person', name: '唐娓' },
  image: [abs(`/images/repair/${r.id}.jpg`)], inLanguage: 'zh-Hant-HK', mainEntityOfPage: abs(`/repair/${r.id}/`), description: d.excerpt,
}];
---
<Base title={`${d.title}｜修器｜唐娓老師`} description={d.excerpt} path={`/repair/${r.id}/`} ogImage={`/images/repair/${r.id}.jpg`} type="article" publishedTime={d.date.toISOString().slice(0, 10)} progress jsonld={jsonld}>
  <article>
    <header class="article-head">
      <nav class="crumbs" aria-label="麵包屑" style="padding:0"><a href={u('/repair/')}>修器</a><span aria-hidden="true">/</span><a href={u(`/repair/#cluster-${cluster.id}`)}>{cluster.name}</a></nav>
      <h1>{d.title}</h1>
      <p class="byline">文／唐娓 · {fmtDate(d.date)}</p>
      <p class="lead">{d.excerpt}</p>
    </header>
    <figure class="article-cover" style="margin-block:0 48px">
      <Cover src={d.cover} alt={d.coverAlt} priority vt={`c-${r.id}`} sizes="(min-width: 1080px) 1040px, 100vw" />
    </figure>
    <div class="prose"><Content /></div>

    <div class="after">
      {used.length > 0 && (
        <section aria-labelledby="terms-h">
          <h2 id="terms-h">這篇提到的詞</h2>
          <div class="term-list">{used.map((t) => <a href={u(`/repair/glossary/#${t.id}`)}>{t.data.term}</a>)}</div>
        </section>
      )}
      {(prev || next) && (
        <nav class="series-nav" aria-label="修器上下篇">
          {prev ? <a class="prev" href={u(`/repair/${prev.id}/`)}><span>上一篇</span><strong>{prev.data.title}</strong></a> : <span></span>}
          {next ? <a class="next" href={u(`/repair/${next.id}/`)}><span>下一篇</span><strong>{next.data.title}</strong></a> : <span></span>}
        </nav>
      )}
      <p style="display:flex;flex-wrap:wrap;gap:8px 32px"><a class="text-link" href={u(`/repair/#cluster-${cluster.id}`)}><span>更多〈{cluster.name}〉</span><Arrow /></a><a class="text-link" href={u('/repair/glossary/')}><span>修補小詞典</span><Arrow /></a></p>
    </div>
  </article>

  {used.map((t) => (
    <div class="term-pop" id={`term-${t.id}`} popover="auto" role="dialog" aria-label={`詞條：${t.data.term}`}>
      <h3>{t.data.term}</h3>
      <p>{t.data.short}</p>
      <a href={u(`/repair/glossary/#${t.id}`)}>看詞典</a>
    </div>
  ))}

  <section class="related" aria-labelledby="more-h">
    <div class="wrap">
      <h2 class="h2" id="more-h">接着讀</h2>
      <div class="article-grid">
        {cards.map((c: any) => c.kind === 'repair'
          ? <ArticleCard href={`/repair/${c.x.id}/`} title={c.x.data.title} excerpt={c.x.data.excerpt} cover={c.x.data.cover} alt="" category="修器" date={fmtDate(c.x.data.date)} />
          : <ArticleCard href={`/journal/${c.x.id}/`} title={c.x.data.title} excerpt={c.x.data.excerpt} cover={c.x.data.cover} alt="" category={categoryName(c.x)} date={fmtDate(c.x.data.date)} />)}
      </div>
    </div>
  </section>
</Base>
