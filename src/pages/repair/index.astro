---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CrackMap from '../../components/CrackMap.astro';
import Cover from '../../components/Cover.astro';
import Arrow from '../../components/Arrow.astro';
import { allRepair, allTerms, clusters, u, fmtDate, shownDate } from '../../lib/site';
const rep = await allRepair();
const byCluster = (id: string) => rep.filter((r) => r.data.cluster === id);
const counts = Object.fromEntries(clusters.map((c) => [c.id, byCluster(c.id).length]));
const start = ['what-is-kintsugi', 'when-a-cup-breaks', 'hot-tea-in-repaired-cups'].map((id) => rep.find((r) => r.id === id)!).filter(Boolean);
const terms = await allTerms();
const sample = ['金繕', '開片', '生漆', '鋦瓷'].map((n) => terms.find((t) => t.data.term === n)!).filter(Boolean);
---
<Base title="修器：茶桌上的修補知識｜唐娓老師" description="茶杯碎了、茶碗裂了怎麼辦？唐娓老師由看懂破損、金繕與鋦瓷談起，一直談到修過的器物怎樣盛茶、怎樣上茶席，一篇一篇讀下去，不必一次讀完。" path="/repair/" ogImage="/images/photography-v2/vessels-cup.webp">
  <section class="band-deep repair-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="麵包屑"><a href={u('/works/')}>器物</a><span aria-hidden="true">/</span><span aria-current="page">修器</span></nav>
      <CrackMap counts={counts}>
        <h1>修器</h1>
        <p class="repair-lead">茶桌上的杯碗，用得愈久，愈難逃過一兩次磕碰。</p>
      </CrackMap>
    </div>
  </section>

  <section class="wrap section" aria-label="修器欄目說明" style="padding-bottom:0">
    <div class="plain-block">
      <p class="t-lead">破了的杯還能不能修，修過的杯還能不能喝茶，是茶友最常問的兩件事。</p>
      <p>這個欄目把問題由淺入深整理：先看懂是哪一種破損，再認識金繕、鋦瓷等方法，最後回到茶桌上，談修過的器物怎樣用、怎樣收。古董或貴重的器物不宜自己動手，請先請教專業的修復師。</p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="start-h">
    <h2 class="h2" id="start-h" style="margin-bottom:40px">從這三篇開始</h2>
    <div class="start-three" data-stagger="cards">
      {start.map((r, i) => <ArticleCard href={`/repair/${r.id}/`} title={r.data.title} excerpt={r.data.excerpt} cover={r.data.cover} alt="" category={clusters.find((c) => c.id === r.data.cluster)!.name} date={shownDate(r)} vt={`c-${r.id}`} priority={i === 0} />)}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:96px">
    {clusters.filter((c) => byCluster(c.id).length).map((c) => {
      const [first, ...rest] = byCluster(c.id);
      return (
        <div class="cluster" id={`cluster-${c.id}`}>
          <div><h2>{c.name}</h2><p class="blurb">{c.blurb}</p></div>
          <div class="cluster-items">
            <ArticleCard variant="feature" href={`/repair/${first.id}/`} title={first.data.title} excerpt={first.data.excerpt} cover={first.data.cover} alt="" date={shownDate(first)} sizes="(min-width: 900px) 700px, 100vw" />
            {rest.length > 0 && (
              <ul class="plain-list">
                {rest.map((r) => <li><a class="row-link" href={u(`/repair/${r.id}/`)}><div><h3>{r.data.title}</h3><p>{r.data.excerpt}</p></div></a></li>)}
              </ul>
            )}
          </div>
        </div>
      );
    })}
  </section>

  <section class="band-deep section">
    <div class="wrap" style="display:grid;gap:40px">
      <div class="section-heading" style="margin-bottom:0"><div><h2 class="h2">修補小詞典</h2><p style="color:var(--green-mist)">文章裏用虛線標出的詞，都可以在這裏查到。</p></div><a class="text-link" href={u('/repair/glossary/')}><span>翻開小詞典</span><Arrow /></a></div>
      <div class="cards-2 gloss-cards" data-stagger="list">
        {sample.map((t) => <a class="gloss-card" href={u(`/repair/glossary/#${t.id}`)}><strong class="serif">{t.data.term}</strong><span>{t.data.short}</span></a>)}
      </div>
    </div>
  </section>
</Base>
