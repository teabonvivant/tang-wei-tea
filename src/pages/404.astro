---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Arrow from '../components/Arrow.astro';
import { getEntry } from 'astro:content';
import { u, categoryName, fmtDate } from '../lib/site';
const ids = ['first-gaiwan', 'raw-ripe-first-lesson', 'room-at-the-table', 'tea-path-awakening-the-senses', 'white-porcelain-day', 'why-hong-kong-loves-puer'];
const pop = await Promise.all(ids.map(async (id) => (await getEntry('articles', id))!));
---
<Base title="找不到這一頁｜唐娓老師" description="這一頁找不到。可以從茶知識、器物或文章目錄繼續閱讀。" path="/404/" noindex noCanonical>
  <section class="wrap not-found">
    <h1>這一頁找不到。</h1>
    <p class="muted">由茶知識、器物或文章目錄，繼續閱讀。</p>
    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
      <a class="button" href={u('/')}>返回首頁</a>
      <a class="text-link" href={u('/works/')}><span>器物與修器</span><Arrow /></a>
      <a class="text-link" href={u('/journal/')}><span>閱讀茶間筆記</span><Arrow /></a>
    </div>
  </section>
  <section class="wrap" style="padding-bottom:128px">
    <h2 class="h2" style="margin-bottom:32px">熱門文章</h2>
    <div class="article-grid">
      {pop.map((a) => <ArticleCard href={`/journal/${a.id}/`} title={a.data.title} excerpt={a.data.excerpt} cover={a.data.cover} alt="" category={categoryName(a)} date={fmtDate(a.data.date)} />)}
    </div>
  </section>
</Base>
