---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u, abs, BRAND, IS_PREVIEW, crumbsFor, pageSchemaType, breadcrumbLd, type Crumb } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  path: string; // 站內路徑，例如 /about/
  ogImage?: string; // 站內路徑
  type?: 'website' | 'article';
  noindex?: boolean;
  noCanonical?: boolean;
  overHero?: boolean;
  jsonld?: any[];
  crumbs?: Crumb[]; // 麵包屑（首頁起）；不給就由網址推出
  fonts?: boolean;
  progress?: boolean;
  publishedTime?: string;
}
const { title, description, path, ogImage = '/images/og-default.jpg', type = 'website', noindex = false, noCanonical = false, overHero = false, jsonld = [], progress = false, publishedTime, crumbs } = Astro.props;
const fullTitle = title;
// 結構化資料：頁面自帶的優先；沒有就補 WebPage／CollectionPage 等；有麵包屑就補 BreadcrumbList（P-24）
const crumbList = crumbs ?? crumbsFor(path);
const ld: any[] = [...jsonld];
if (!ld.length) ld.push({ '@context': 'https://schema.org', '@type': pageSchemaType(path), name: title, description, url: abs(path), inLanguage: 'zh-Hant-HK', isPartOf: { '@type': 'WebSite', name: BRAND, url: abs('/') } });
if (crumbList.length > 1 && !ld.some((j) => j['@type'] === 'BreadcrumbList')) ld.push(breadcrumbLd(crumbList));
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const robots = IS_PREVIEW || noindex ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noCanonical && <link rel="canonical" href={abs(path)} />}
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    <meta property="og:image" content={abs(ogImage)} />
    {ogImage.startsWith('/images/og') && <meta property="og:image:width" content="1200" />}
    {ogImage.startsWith('/images/og') && <meta property="og:image:height" content="630" />}
    <meta property="og:locale" content="zh_HK" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="theme-color" content="#f6f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c2420" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${BRAND}｜茶間筆記與修器`} href={u('/rss.xml')} />
    <script is:inline>
      document.documentElement.classList.add('js');
      addEventListener('pagereveal', function (e) { if (e.viewTransition) document.documentElement.classList.add('vt-in'); });
      try {
        var t = localStorage.getItem('tong-tea-theme');
        if (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        if (t === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
    <slot name="head" />
    {ld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    {beacon && !IS_PREVIEW && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <div class="top-sentinel" aria-hidden="true"></div>
    <Header overHero={overHero} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
