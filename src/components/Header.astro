---
import { u, wa, BRAND } from '../lib/site';
import SearchBox from './SearchBox.astro';
const { overHero = false } = Astro.props;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const is = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
// P-05 方案甲：茶知識｜文章（茶間筆記／茶逢知己）｜器物｜修器｜課程｜關於。桌面與手機選單同一套次序。
const articleLinks = [['/journal/', '茶間筆記'], ['/columns/', '茶逢知己']];
const nav = [
  { type: 'link', href: '/tea/', label: '茶知識', match: ['/tea/', '/topics/'] },
  { type: 'drop', id: 'drop-articles', label: '文章', match: ['/journal/', '/columns/'], items: articleLinks },
  { type: 'link', href: '/works/', label: '器物', match: ['/works/'] },
  { type: 'link', href: '/repair/', label: '修器', match: ['/repair/'] },
  { type: 'link', href: '/courses/', label: '課程', match: ['/courses/'] },
  { type: 'link', href: '/about/', label: '關於', match: ['/about/', '/events/', '/projects/'] },
];
// 手機選單：同一套頂層次序，次級連結列在下面
const menu: { href?: string; label: string; match: string[]; subs?: string[][] }[] = [
  { href: '/tea/', label: '茶知識', match: ['/tea/', '/topics/'] },
  { label: '文章', match: ['/journal/', '/columns/'], subs: articleLinks },
  { href: '/works/', label: '器物', match: ['/works/'], subs: [['/topics/vessels/', '選器·用器'], ['/topics/hosting/', '茶席']] },
  { href: '/repair/', label: '修器', match: ['/repair/'], subs: [['/repair/glossary/', '修補小詞典']] },
  { href: '/courses/', label: '課程', match: ['/courses/'] },
  { href: '/about/', label: '關於', match: ['/about/', '/events/', '/projects/'], subs: [['/events/', '教學紀錄'], ['/projects/youth-tea-culture/', '青年與茶'], ['/contact/', '聯絡']] },
];
const caret = 'M212.24,100.24l-80,80a6,6,0,0,1-8.48,0l-80-80a6,6,0,0,1,8.48-8.48L128,167.51l75.76-75.75a6,6,0,0,1,8.48,8.48Z';
const glass = 'M228.24,219.76l-51.38-51.38a86.15,86.15,0,1,0-8.48,8.48l51.38,51.38a6,6,0,0,0,8.48-8.48ZM38,112a74,74,0,1,1,74,74A74.09,74.09,0,0,1,38,112Z';
---
<header class:list={['site-header', { 'over-hero': overHero }]}>
  <div class="wrap header-row">
    <a class="wordmark" href={u('/')} aria-label={`${BRAND}，返回首頁`}><span>{BRAND}</span><small>茶·器物·日常</small></a>
    <nav class="desktop-nav" aria-label="主要選單">
      {nav.map((n) => n.type === 'link' ? (
        <a href={u(n.href!)} aria-current={n.match.some((m) => is(m)) ? 'page' : undefined}>{n.label}</a>
      ) : (
        <div class="nav-drop" data-drop>
          <button type="button" class="nav-drop-btn" aria-expanded="false" aria-controls={n.id} data-current={n.match.some((m) => is(m)) ? 'true' : undefined}>
            <span>{n.label}</span>
            <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d={caret} /></svg>
          </button>
          <div class="drop-panel" id={n.id}>
            {n.items!.map(([h, l]) => <a href={u(h)} aria-current={is(h) ? 'page' : undefined}>{l}</a>)}
          </div>
        </div>
      ))}
      <a class="header-search" href={u('/journal/#search')} aria-label="搜尋文章">
        <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d={glass} /></svg>
      </a>
    </nav>
    <a class="header-contact button" href={u('/contact/')}>聯絡唐老師</a>
    <div class="header-tools">
    <a class="header-wa" href={wa('你好，我想查詢茶藝課程或合作。')} aria-label="用 WhatsApp 聯絡唐老師">
      <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M186.68,146.63l-32-16a6,6,0,0,0-6,.38L133,141.46A42.49,42.49,0,0,1,114.54,123L125,107.33a6,6,0,0,0,.38-6l-16-32A6,6,0,0,0,104,66a38,38,0,0,0-38,38,86.1,86.1,0,0,0,86,86,38,38,0,0,0,38-38A6,6,0,0,0,186.68,146.63ZM152,178a74.09,74.09,0,0,1-74-74,26,26,0,0,1,22.42-25.75l12.66,25.32-10.39,15.58a6,6,0,0,0-.54,5.63,54.43,54.43,0,0,0,29.07,29.07,6,6,0,0,0,5.63-.54l15.58-10.39,25.32,12.66A26,26,0,0,1,152,178ZM128,26A102,102,0,0,0,38.35,176.69L26.73,211.56a14,14,0,0,0,17.71,17.71l34.87-11.62A102,102,0,1,0,128,26Zm0,192a90,90,0,0,1-45.06-12.08,6.09,6.09,0,0,0-3-.81,6.2,6.2,0,0,0-1.9.31L40.65,217.88a2,2,0,0,1-2.53-2.53L50.58,178a6,6,0,0,0-.5-4.91A90,90,0,1,1,128,218Z" /></svg>
    </a>
    <button type="button" class="menu-toggle" aria-controls="mobile-menu" aria-expanded="false" aria-label="開啟選單" data-menu-open>
      <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M222,128a6,6,0,0,1-6,6H40a6,6,0,0,1,0-12H216A6,6,0,0,1,222,128ZM40,70H216a6,6,0,0,0,0-12H40a6,6,0,0,0,0,12ZM216,186H40a6,6,0,0,0,0,12H216a6,6,0,0,0,0-12Z" /></svg>
    </button>
    </div>
  </div>
</header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="網站選單">
  <div class="menu-inner">
    <div class="menu-top">
      <span class="serif menu-brand">{BRAND}</span>
      <button type="button" class="menu-toggle" aria-label="關閉選單" data-menu-close>
        <svg aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M204.24,195.76a6,6,0,1,1-8.48,8.48L128,136.49,60.24,204.24a6,6,0,0,1-8.48-8.48L119.51,128,51.76,60.24a6,6,0,0,1,8.48-8.48L128,119.51l67.76-67.75a6,6,0,0,1,8.48,8.48L136.49,128Z" /></svg>
      </button>
    </div>
    <SearchBox id="menu-search" variant="menu" />
    <nav aria-label="手機選單" class="menu-nav">
      <div class="menu-group"><a href={u('/')} aria-current={path === '/' ? 'page' : undefined}>首頁</a></div>
      {menu.map((m) => (
        <div class="menu-group">
          {m.href ? <a href={u(m.href)} aria-current={path === m.href ? 'page' : undefined}>{m.label}</a> : <p class="menu-title">{m.label}</p>}
          {m.subs && <div class="menu-subs">{m.subs.map(([h, l]) => <a href={u(h)} aria-current={path === h ? 'page' : undefined}>{l}</a>)}</div>}
        </div>
      ))}
    </nav>
  </div>
</dialog>
