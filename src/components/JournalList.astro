---
import ArticleCard from './ArticleCard.astro';
import { u, topicList, categoryName, shownDate, type Article } from '../lib/site';
interface Props { items: Article[]; current?: string; page?: number; pages?: number; basePath?: string; }
const { items, current = 'all', page = 1, pages = 1, basePath = '/journal/' } = Astro.props;
const chips = [['all', '全部', '/journal/'], ['column', '茶逢知己', '/columns/'], ...topicList.map((t) => [t.slug, t.name, `/topics/${t.slug}/`])];
const pageHref = (n: number) => (n === 1 ? basePath : `${basePath}page/${n}/`);
---
<nav class="chips" aria-label="文章類別">
  {chips.map(([id, label, href]) => <a href={u(href)} aria-current={id === current ? 'page' : undefined}>{label}</a>)}
</nav>
<div class="article-grid">
  {items.map((a, i) => (
    <ArticleCard href={`/journal/${a.id}/`} title={a.data.title} excerpt={a.data.excerpt} cover={a.data.cover} alt="" category={categoryName(a)} date={shownDate(a)} vt={`c-${a.id}`} priority={i < 2 && page === 1} level={2} />
  ))}
</div>
{pages > 1 && (
  <nav class="pager" aria-label="分頁">
    {page > 1 && <a href={u(pageHref(page - 1))} rel="prev">上一頁</a>}
    {Array.from({ length: pages }, (_, k) => k + 1).map((n) => n === page ? <span aria-current="page">{n}</span> : <a href={u(pageHref(n))} aria-label={`第 ${n} 頁`}>{n}</a>)}
    {page < pages && <a href={u(pageHref(page + 1))} rel="next">下一頁</a>}
  </nav>
)}
