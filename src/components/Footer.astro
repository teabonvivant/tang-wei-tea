---
import { u } from '../lib/site';
const cols = [
  { title: '讀茶', items: [['/tea/', '茶知識'], ['/journal/', '茶間筆記'], ['/columns/', '茶逢知己'], ['/puer-tea-knowledge/', '普洱茶知識庫', 'raw'], ['/six-tea-knowledge/', '六大茶知識庫', 'raw']] },
  { title: '器物', items: [['/works/', '器物總覽'], ['/repair/', '修器'], ['/repair/glossary/', '修補小詞典'], ['/topics/hosting/', '茶席']] },
  { title: '唐老師', items: [['/about/', '關於唐老師'], ['/courses/', '課程與合作'], ['/events/', '教學紀錄'], ['/contact/', '聯絡']] },
  { title: '本站', items: [['/sources/', '文字與圖片說明'], ['/projects/youth-tea-culture/', '青年與茶']] },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div style="display:grid;gap:16px">
        <a class="wordmark" href={u('/')}><span>唐老師</span><small>茶·器物·日常</small></a>
        <p>茶在杯中，日子在席上。</p>
      </div>
      <a class="button on-deep" href={u('/contact/')}>聯絡唐老師</a>
    </div>
    <div class="footer-cols">
      {cols.map((c) => (
        <nav aria-label={`頁尾：${c.title}`}>
          <h2>{c.title}</h2>
          {c.items.map(([h, l, raw]) => <a href={raw ? h : u(h)}>{l}</a>)}
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© 2026 唐娓老師 · 茶與日常</p>
      <button type="button" class="theme-toggle" aria-label="切換淺色或深色外觀" data-theme-toggle>
        <svg class="sun-icon" aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M122,40V16a6,6,0,0,1,12,0V40a6,6,0,0,1-12,0Zm68,88a62,62,0,1,1-62-62A62.07,62.07,0,0,1,190,128Zm-12,0a50,50,0,1,0-50,50A50.06,50.06,0,0,0,178,128ZM59.76,68.24a6,6,0,1,0,8.48-8.48l-16-16a6,6,0,0,0-8.48,8.48Zm0,119.52-16,16a6,6,0,1,0,8.48,8.48l16-16a6,6,0,1,0-8.48-8.48ZM192,70a6,6,0,0,0,4.24-1.76l16-16a6,6,0,0,0-8.48-8.48l-16,16A6,6,0,0,0,192,70Zm4.24,117.76a6,6,0,0,0-8.48,8.48l16,16a6,6,0,0,0,8.48-8.48ZM46,128a6,6,0,0,0-6-6H16a6,6,0,0,0,0,12H40A6,6,0,0,0,46,128Zm82,82a6,6,0,0,0-6,6v24a6,6,0,0,0,12,0V216A6,6,0,0,0,128,210Zm112-88H216a6,6,0,0,0,0,12h24a6,6,0,0,0,0-12Z" /></svg>
        <svg class="moon-icon" aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M232.13,143.64a6,6,0,0,0-6-1.49A90.07,90.07,0,0,1,113.86,29.85a6,6,0,0,0-7.49-7.48A102.88,102.88,0,0,0,54.48,58.68,102,102,0,0,0,197.32,201.52a102.88,102.88,0,0,0,36.31-51.89A6,6,0,0,0,232.13,143.64Zm-42,48.29a90,90,0,0,1-126-126A90.9,90.9,0,0,1,99.65,37.66,102.06,102.06,0,0,0,218.34,156.35,90.9,90.9,0,0,1,190.1,191.93Z" /></svg>
        <span>切換外觀</span>
      </button>
    </div>
  </div>
</footer>
